# =============================================================================
# 로컬 개발용 환경 변수 템플릿
# 사용법: 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요.
#   cp .env.example .env
#
# ⚠️ `.env` 는 git에 올라가지 않습니다 (.gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase (필수) — Vite 빌드·배포 시 반드시 필요
# Firebase 콘솔 → 프로젝트 설정(톱니) → 일반 → 내 앱 → SDK 설정 및 구성
# 본인 프로젝트(Band-Info 등)의 값으로 채우세요. 예전 band-info-58b2d 와 다를 수 있음.
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# -----------------------------------------------------------------------------
# 선택 — 없으면 앱 기본값 또는 manage에서 URL 직접 입력
# -----------------------------------------------------------------------------
# Google Sheets 연동 (manage > 게스트 시트 동기화)
VITE_GOOGLE_SHEETS_WEB_APP_URL=

# 채팅 페이지 사진첩 링크
VITE_GOOGLE_DRIVE_LINK=

# -----------------------------------------------------------------------------
# 로컬 전용 (node server — `npm run dev:server`)
# Vercel 프론트 배포에는 넣지 않아도 됩니다.
# -----------------------------------------------------------------------------
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# -----------------------------------------------------------------------------
# 서버 전용 (VITE_ 접두사 금지 — 클라이언트 번들에 노출됨)
# Vercel: 프로젝트 Settings → Environment Variables 에 설정
# 로컬: `.env` 에 설정 후 `npm run dev:server` 또는 `npm run dev:all`
# ⚠️ 비밀번호는 git에 올리지 마세요. Vercel Environment Variables에 설정하세요.
# -----------------------------------------------------------------------------
ADMIN_LOGIN_CODE=
ADMIN_ACTION_PASSWORD=
# Firebase Admin SDK (서버 API 전용) — JSON 전체 또는 base64 인코딩
# 키 파일(*firebase-adminsdk*.json)은 git에 올리지 말고 .env에만 넣으세요.
FIREBASE_SERVICE_ACCOUNT=
# 선택: 관리자 API 토큰 서명용 (미설정 시 ADMIN_ACTION_PASSWORD 사용)
ADMIN_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# 카카오 로그인 (선택) — 비워 두면 /ui 의 로그인은 목으로 동작합니다
# 카카오 개발자 콘솔 https://developers.kakao.com/console/app
#
# 1) 브라우저에서 쓰는 키 (공개돼도 되는 값)
#    앱 > 플랫폼 키 > JavaScript 키
VITE_KAKAO_JS_KEY=
#
# 2) 서버에서만 쓰는 값 — 절대 VITE_ 를 붙이지 마세요 (붙이면 브라우저로 나갑니다)
#    앱 > 플랫폼 키 > REST API 키
KAKAO_REST_API_KEY=
#    앱 > 플랫폼 키 > REST API 키 > 클라이언트 시크릿 > **카카오 로그인**
#    시크릿이 「카카오 로그인」 과 「비즈니스 인증」 둘로 나뉩니다. 우리가 쓰는 건
#    카카오 로그인 쪽입니다 — 서버가 kauth.kakao.com/oauth/token 을 부릅니다.
#    비즈니스 인증은 본인확인 상품이라 우리와 상관없습니다.
#    새 키는 켜진 채로 만들어집니다 — 켜져 있으면 토큰 요청에 반드시 들어가야 합니다.
KAKAO_CLIENT_SECRET=
#
# 3) 돌아올 주소를 콘솔에 등록해야 합니다 — 안 하면 KOE006 으로 막힙니다.
#    리다이렉트 URI 도 「카카오 로그인」 과 「비즈니스 인증」 으로 나뉩니다 —
#    카카오 로그인 쪽에 넣으세요. 그리고 **키마다 따로** 등록합니다. 우리는
#    JavaScript 키로 보내고 REST API 키로 토큰을 바꾸므로 **두 키 모두**에
#    같은 값을 넣어야 합니다.
#      http://localhost:5190/ui/auth/kakao
#      https://www.hibandy.com/ui/auth/kakao
#    그리고 앱 > 플랫폼 키 > JavaScript 키 > JavaScript SDK 도메인 에 주소를 등록해야
#    브라우저 요청이 거절되지 않습니다. 마지막으로 카카오 로그인 > 사용 설정 을 ON
#    으로 두세요 (OFF 면 KOE004).

# -----------------------------------------------------------------------------
# 포트원 (PortOne) — 카드 결제. 지금은 테스트 채널만 씁니다.
# https://admin.portone.io → 결제 연동 → 연동 정보
#
# ⚠️ 테스트 채널 키만 넣으세요. 라이브 키를 넣으면 실제로 돈이 빠집니다.
# 비워 두면 결제창을 띄우지 않고 화면 흐름만 보여 줍니다 (src/lightui/pay/portone.ts).
# -----------------------------------------------------------------------------
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=

# -----------------------------------------------------------------------------
# 웹 푸시 (Firebase Cloud Messaging) — 카카오 알림톡 대신 쓰는 자리
# Firebase 콘솔 → 프로젝트 설정 → 클라우드 메시징 → 웹 구성 → 웹 푸시 인증서
#
# 비워 두면 알림 받기 버튼이 「준비 중」 으로 뜨고 권한을 묻지 않습니다.
# -----------------------------------------------------------------------------
VITE_FIREBASE_VAPID_KEY=

# -----------------------------------------------------------------------------
# 입금 계좌 (선택) — /ui 입금 안내 화면에 그리는 계좌
# 셋이 다 있어야 계좌를 그립니다. 하나라도 비면 화면이 「아직 등록 전」 이라고
# 말하고 「입금했어요」 버튼도 눌리지 않습니다.
#
# 목 계좌번호를 띄워 두면 누군가는 그리로 보냅니다. 값이 없으면 지어내지
# 않는 쪽이 맞습니다.
# -----------------------------------------------------------------------------
VITE_BANK_NAME=
VITE_BANK_ACCOUNT=
VITE_BANK_HOLDER=
